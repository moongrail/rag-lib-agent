# ---- Core ----
SPRING_PROFILES_ACTIVE=rest,webui

# PostgreSQL + pgvector
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rag
SPRING_DATASOURCE_USERNAME=rag
SPRING_DATASOURCE_PASSWORD=rag

# OpenRouter (LLM chat) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Embedding provider selection: ollama | huggingface | openai | lmstudio | local
EMBEDDING_PROVIDER=ollama
# For provider=openai (another provider's embedding API)
EMBEDDING_API_KEY=sk-...

# Chat provider selection: openrouter | lmstudio
# (LM Studio runs locally with an OpenAI-compatible API at http://localhost:1234/v1)
CHAT_PROVIDER=openrouter

# Telegram (only when profile 'telegram' active)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Security (JWT) — enable in application.yml (app.security.enabled=true)
JWT_SECRET=change-me-in-production
